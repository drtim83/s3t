rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Organizations
    match /organizations/{orgId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /members/{memberId} {
        allow read, write: if request.auth != null;
      }

      match /rates/{rateId} {
        allow read, write: if request.auth != null;
      }
    }

    // Projects
    match /projects/{projectId} {
      // Allow read if authenticated or if project is shared publicly with a valid share token
      allow read: if request.auth != null || resource.data.is_shared == true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;

      // Project Members
      match /members/{memberId} {
        allow read, write: if request.auth != null;
      }

      // Procurement & Third-Party Line Items
      match /procurement/{itemId} {
        allow read: if request.auth != null || get(/databases/$(database)/documents/projects/$(projectId)).data.is_shared == true;
        allow write: if request.auth != null;
      }

      // Project Approvals & Workflow
      match /approvals/{approvalId} {
        allow read, write: if request.auth != null;
      }
    }

    // WBS Elements (Work Breakdown Structure)
    match /wbs_elements/{elementId} {
      allow read: if request.auth != null || resource.data.is_shared == true;
      allow write: if request.auth != null;
    }

    // Discussions & Task Comments
    match /discussions/{commentId} {
      allow read, write: if request.auth != null;
    }
  }
}
